<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Скупка [pre-beta 4.5]</title>
<style>
:root {
  --bg: #090d16;
  --panel: rgba(18, 26, 43, 0.75);
  --card: rgba(26, 36, 59, 0.6);
  --card-border: rgba(0, 242, 254, 0.18);
  --ink: #f0f4f8;
  --mu: #8b9bb4;
  --acc: #00f2fe;
  --acc2: #4facfe;
  --neon-pink: #ff007f;
  --ok: #00e676;
  --bad: #ff3366;
  --warn: #ffab00;
  --nv: #0a101d;
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
}
* { box-sizing: border-box; margin: 0; padding: 0; -webkit-user-select: none; user-select: none; font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; }
html, body { height: 100%; }
body {
  background-color: var(--bg);
  background-image: 
    radial-gradient(circle at 15% 15%, rgba(0, 242, 254, 0.12), transparent 40%),
    radial-gradient(circle at 85% 85%, rgba(255, 0, 127, 0.1), transparent 40%),
    linear-gradient(rgba(255,255,255,.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.02) 1px, transparent 1px);
  background-size: 100% 100%, 100% 100%, 30px 30px, 30px 30px;
  color: var(--ink);
  overflow: hidden;
}

#app { height: 100%; display: flex; flex-direction: column; }

header {
  display: flex; justify-content: space-between; align-items: center; gap: 8px;
  padding: 10px 14px; background: rgba(10, 16, 29, 0.85);
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(0, 242, 254, 0.3);
  box-shadow: 0 4px 20px rgba(0, 242, 254, 0.15);
  z-index: 10;
}
.br { font-weight: 900; font-size: 16px; letter-spacing: 0.5px; background: linear-gradient(45deg, var(--acc), var(--neon-pink)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
.br small { display: block; font-weight: 600; font-size: 10px; color: var(--mu); -webkit-text-fill-color: var(--mu); }

.st { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; font-size: 11px; font-weight: 700; }
.st div {
  background: rgba(255, 255, 255, 0.05); padding: 4px 8px; border-radius: 8px;
  border: 1px solid rgba(255, 255, 255, 0.08); backdrop-filter: blur(4px);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.1);
}

main { flex: 1; overflow-y: auto; padding: 14px; scroll-behavior: smooth; }
.sc { display: none; opacity: 0; transition: opacity 0.3s ease; }
.sc.on { display: block; opacity: 1; }

h3 { margin-bottom: 8px; font-size: 18px; font-weight: 800; letter-spacing: 0.3px; display: flex; align-items: center; gap: 8px; }
.mu { font-size: 12px; color: var(--mu); margin-bottom: 10px; }

.g { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; margin-top: 10px; }

.c {
  background: var(--card); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  color: var(--ink); border-radius: 14px; border: 1px solid var(--card-border);
  padding: 12px 14px; display: flex; flex-direction: column; gap: 8px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3); transition: transform 0.2s ease, border-color 0.2s ease;
  position: relative; overflow: hidden;
}
.c:hover { transform: translateY(-2px); border-color: var(--acc); }
.c::before { content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: linear-gradient(180deg, var(--acc), var(--neon-pink)); }

.t { font-weight: 800; font-size: 15px; color: #fff; }
.pr { font-weight: 800; font-size: 16px; color: var(--ok); text-shadow: 0 0 10px rgba(0, 230, 118, 0.3); }

.tag { font-size: 10px; font-weight: 700; padding: 3px 8px; border-radius: 20px; background: rgba(0, 242, 254, 0.1); border: 1px solid rgba(0, 242, 254, 0.3); color: var(--acc); align-self: flex-start; }
.tag.bad { background: rgba(255, 51, 102, 0.1); border-color: rgba(255, 51, 102, 0.3); color: var(--bad); }
.tag.warn { background: rgba(255, 171, 0, 0.1); border-color: rgba(255, 171, 0, 0.3); color: var(--warn); }

.b {
  border: 0; border-radius: 10px; padding: 10px 14px; font-weight: 700; font-size: 12px;
  background: linear-gradient(135deg, var(--acc), var(--acc2)); color: #000; cursor: pointer;
  box-shadow: 0 4px 15px rgba(0, 242, 254, 0.3); transition: all 0.2s ease; display: inline-flex;
  align-items: center; justify-content: center; gap: 6px; text-transform: uppercase; letter-spacing: 0.5px;
}
.b:active { transform: scale(0.96); box-shadow: none; }
.b:disabled { opacity: 0.4; cursor: not-allowed; transform: none; box-shadow: none; }
.b.ok { background: linear-gradient(135deg, #00e676, #00b0ff); color: #000; box-shadow: 0 4px 15px rgba(0, 230, 118, 0.3); }
.b.bad { background: linear-gradient(135deg, #ff3366, #ff007f); color: #fff; box-shadow: 0 4px 15px rgba(255, 51, 102, 0.3); }
.b.g2 { background: rgba(255, 255, 255, 0.08); color: #fff; border: 1px solid rgba(255, 255, 255, 0.15); box-shadow: none; }
.b.g2:hover { background: rgba(255, 255, 255, 0.15); }

.row { display: flex; gap: 8px; align-items: center; justify-content: space-between; flex-wrap: wrap; }

nav { display: flex; background: var(--nv); border-top: 1px solid rgba(0, 242, 254, 0.2); backdrop-filter: blur(12px); overflow-x: auto; }
nav div { flex: 1; min-width: 65px; text-align: center; padding: 10px 2px; font-size: 9px; font-weight: 700; color: var(--mu); cursor: pointer; transition: all 0.2s ease; position: relative; }
nav div.on { color: var(--acc); text-shadow: 0 0 8px rgba(0, 242, 254, 0.5); }
nav div.on::after { content: ''; position: absolute; top: 0; left: 20%; right: 20%; height: 2px; background: var(--acc); box-shadow: 0 0 10px var(--acc); }
nav span { display: block; font-size: 16px; margin-bottom: 2px; }

.ov { position: fixed; inset: 0; background: rgba(5, 8, 15, 0.85); backdrop-filter: blur(10px); z-index: 50; display: none; justify-content: center; align-items: center; padding: 14px; }
.mb { background: rgba(18, 26, 43, 0.95); border: 1px solid var(--acc); border-radius: 20px; padding: 18px; width: 100%; max-width: 440px; max-height: 90vh; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; box-shadow: 0 0 30px rgba(0, 242, 254, 0.2); }

.chat { height: 200px; overflow-y: auto; background: rgba(0, 0, 0, 0.4); border-radius: 12px; padding: 10px; display: flex; flex-direction: column; gap: 8px; border: 1px solid rgba(255, 255, 255, 0.05); }
.m { max-width: 85%; padding: 8px 12px; border-radius: 12px; font-size: 12px; line-height: 1.4; }
.ms { background: rgba(255, 255, 255, 0.1); color: #fff; align-self: flex-start; border-bottom-left-radius: 2px; }
.mu2 { background: linear-gradient(135deg, var(--acc), var(--acc2)); color: #000; font-weight: 700; align-self: flex-end; border-bottom-right-radius: 2px; }

.ph { background: #0c1424; border: 2px solid rgba(0, 242, 254, 0.3); border-radius: 20px; padding: 14px; display: flex; flex-direction: column; gap: 10px; box-shadow: inset 0 0 20px rgba(0,0,0,0.8); }
.cp { background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px; padding: 10px; font-size: 12px; display: flex; flex-direction: column; gap: 6px; }
.cp.bd { border-color: var(--bad); background: rgba(255, 51, 102, 0.05); }
.cp.gd { border-color: var(--ok); background: rgba(0, 230, 118, 0.05); }

.sw { width: 36px; height: 36px; border-radius: 50%; background: radial-gradient(#fff, #777); border: 2px solid #000; cursor: pointer; box-shadow: 0 0 10px rgba(255,255,255,0.5); transition: transform 0.2s; }
.sw.off { opacity: 0.15; box-shadow: none; transform: scale(0.8); }

.bar { position: relative; height: 26px; background: rgba(0, 0, 0, 0.6); border-radius: 13px; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.1); }
.zn { position: absolute; top: 0; bottom: 0; background: rgba(0, 230, 118, 0.5); border: 1px solid var(--ok); }
.mk { position: absolute; top: 0; bottom: 0; width: 6px; background: #fff; box-shadow: 0 0 10px #fff; border-radius: 3px; }
.pg { position: absolute; left: 0; top: 0; bottom: 0; background: linear-gradient(90deg, var(--acc), var(--neon-pink)); }

#toast { position: fixed; left: 14px; right: 14px; top: calc(env(safe-area-inset-top, 0px) + 65px); z-index: 99; display: flex; flex-direction: column; gap: 8px; pointer-events: none; }
#toast div { background: rgba(18, 26, 43, 0.95); color: #fff; border-left: 4px solid var(--acc); border-radius: 10px; padding: 12px 16px; font-size: 13px; font-weight: 700; box-shadow: 0 10px 30px rgba(0,0,0,0.5); backdrop-filter: blur(10px); animation: slideIn 0.3s cubic-bezier(0.18, 0.89, 0.32, 1.28); }

@keyframes slideIn { from { transform: translateY(-20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

#menu { position: fixed; inset: 0; z-index: 90; background: var(--bg); display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 16px; padding: 24px; text-align: center; }
select, input[type=text] { width: 100%; max-width: 320px; padding: 12px 16px; border-radius: 10px; border: 1px solid rgba(0, 242, 254, 0.3); background: rgba(26, 36, 59, 0.8); color: #fff; outline: none; font-size: 13px; }
select:focus, input[type=text]:focus { border-color: var(--acc); box-shadow: 0 0 15px rgba(0, 242, 254, 0.3); }

::-webkit-scrollbar { width: 4px; height: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(0, 242, 254, 0.2); border-radius: 2px; }
</style>
</head>
<body>
<div id="app">
  <header>
